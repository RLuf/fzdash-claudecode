# FZDash-ClaudeCode Configuration
FZDASH_PORT=3847
FZDASH_HOST=0.0.0.0

# Qdrant (rodando no papaimach)
QDRANT_URL=http://192.168.0.101:6363

# Claude Code
CLAUDE_CODE_PATH=claude
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-5-20250929
CLAUDE_MAX_ITERATIONS=10

# Terminal
TERMINAL_MAX_SESSIONS=10
TERMINAL_IDLE_TIMEOUT=3600000

# File Watcher
FILE_WATCHER_IGNORED=node_modules,dist,.git,*.log,*.tmp
FILE_WATCHER_MAX_DEPTH=5

# Development
DEBUG=false
VERBOSE=false
