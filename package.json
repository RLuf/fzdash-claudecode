{
  "name": "fzdash-claudecode",
  "version": "1.0.0",
  "description": "FazAI-NG Dashboard for Claude Code - Modular Web Interface with Real-time Execution Monitoring",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsup src/server/index.ts --format esm --dts --outDir dist/server",
    "start": "node dist/server/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "install:ralph": "node scripts/install-ralph-wiggum.js",
    "setup": "node scripts/setup.js"
  },
  "keywords": [
    "fazai",
    "claude-code",
    "dashboard",
    "ai",
    "agentic",
    "qdrant",
    "ecoa"
  ],
  "author": "FazAI Team <rogerluft@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rogerluft/fazai-ng"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@qdrant/js-client-rest": "^1.12.0",
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "diff": "^8.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "inquirer": "^12.1.0",
    "node-pty": "^1.0.0",
    "octokit": "^4.0.2",
    "ora": "^8.1.1",
    "simple-git": "^3.27.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "ws": "^8.18.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/diff": "^5.2.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.16.0",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.2",
    "recharts": "^2.14.1",
    "tailwindcss": "^3.4.16",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.0.17"
  }
}
