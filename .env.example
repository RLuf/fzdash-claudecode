# FZDash-ClaudeCode Environment Configuration
# Copy this file to .env and fill in your values

# ============ Server Configuration ============
FZDASH_PORT=3847
FZDASH_HOST=0.0.0.0

# ============ Qdrant Configuration ============
QDRANT_URL=http://localhost:6363
QDRANT_API_KEY=

# ECOA Collections (comma-separated)
QDRANT_COLLECTIONS=fazai_personality,fazai_memory,fazai_learning,fazai_kb,fazai_source

# ============ GitHub Configuration ============
# Get token at: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# ============ Claude Code Configuration ============
# Path to Claude Code CLI (leave empty for system PATH)
CLAUDE_CODE_PATH=claude

# Default AI model
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-5-20250929

# Maximum iterations for Ralph-Wiggum loops
CLAUDE_MAX_ITERATIONS=10

# Skip permission prompts (DANGEROUS - use with caution)
CLAUDE_SKIP_PERMISSIONS=false

# ============ Terminal Configuration ============
# Default shell (auto-detect if empty)
# Windows: powershell.exe or pwsh.exe
# Linux: /bin/bash or /bin/zsh
TERMINAL_SHELL=

# Maximum concurrent terminal sessions
TERMINAL_MAX_SESSIONS=10

# Idle timeout in milliseconds (1 hour default)
TERMINAL_IDLE_TIMEOUT=3600000

# ============ File Watcher Configuration ============
# Patterns to ignore (comma-separated)
FILE_WATCHER_IGNORED=node_modules,dist,.git,*.log,*.tmp

# Maximum directory depth to watch
FILE_WATCHER_MAX_DEPTH=5

# ============ Development Configuration ============
# Enable debug logging
DEBUG=false

# Enable verbose output
VERBOSE=false

# Log file path
LOG_FILE=./fzdash.log
